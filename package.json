{
  "name": "nest-boilerplate",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "@nestjs/common": "next",
    "@nestjs/config": "12.0.0-next.0",
    "@nestjs/core": "next",
    "@nestjs/platform-express": "next",
    "@nestjs/swagger": "12.0.0-alpha.2",
    "@nestjs/typeorm": "11.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/nestjs": "^10.69.0",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.24",
    "dotenv": "^17.4.2",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "next",
    "@nestjs/schematics": "next",
    "@nestjs/testing": "next",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  }
